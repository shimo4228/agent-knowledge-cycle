    {
      "@id": "https://shimo4228.github.io/shimo4228/vocab#prior-art/agent-human-interaction-security",
      "@type": ["ExternalReference", "ScholarlyArticle"],
      "name": "Reframing LLM Agent Security as an Agent-Human Interaction Problem",
      "author": "Wang, P. et al.",
