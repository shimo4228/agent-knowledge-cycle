    {
      "@id": "https://github.com/shimo4228/agent-stocktake",
      "@type": ["EcosystemRepo", "SoftwareSourceCode"],
      "name": "agent-stocktake",
      "description": "AKC Curate-phase skill — semantic / judgment layer for agent definitions (ADR-0019). Audits agent definitions with a hybrid cost model: the description is always-loaded via the agent-type listing (residency, like a rule) while the body loads only on invocation (like a skill), so the two layers get different audit questions. Screens for suppression instructions (Improve-by-inversion: rewrite the direction, never just delete), previous-generation over-constraint, and substrate absorption judged on a fresh/rich context axis. Completes the stocktake set beside skill-stocktake and rules-stocktake.",
      "url": "https://github.com/shimo4228/agent-stocktake",
      "extends": "https://doi.org/10.5281/zenodo.19200726",
      "implements": "https://shimo4228.github.io/shimo4228/vocab#akc-phase/curate",
      "groundedIn": "https://github.com/shimo4228/agent-knowledge-cycle/blob/main/docs/adr/0019-cycle-structure-is-provisional.md"
    },
    {
      "@id": "https://github.com/shimo4228/generation-audit",
      "@type": ["EcosystemRepo", "SoftwareSourceCode"],
      "name": "generation-audit",
      "description": "Skill scaffolding Scaffold Dissolution's model-generation trigger (a snapshot, mutable; ADR-0019). When a model generation ships, it captures the live runtime layer (system prompt + tool descriptions) in verbatim quotes, classifies mismatches with self-authored assets as conflict / redundancy / drift, judges each with an intent / evidence / freshness / expiry frame, and hands the evidence dossier to the per-asset-class stocktake skills — it holds no verdicts itself. The instrument that produces generation review, the fourth retirement evidence class (ADR-0023).",
      "url": "https://github.com/shimo4228/generation-audit",
      "extends": "https://doi.org/10.5281/zenodo.19200726",
      "implements": "https://shimo4228.github.io/shimo4228/vocab#concept/scaffold-dissolution",
      "groundedIn": "https://github.com/shimo4228/agent-knowledge-cycle/blob/main/docs/adr/0023-generation-review-as-a-fourth-evidence-class.md"
    },
    {
      "@id": "https://github.com/shimo4228/human-gate",
      "@type": ["EcosystemRepo", "SoftwareSourceCode"],
      "name": "human-gate",
      "description": "Always-loaded rule plus deterministic hook scaffolding the human approval gate in the cycle's first running instance, the author's harness (a snapshot, mutable; ADR-0019). Fixes what the human judges at the gate — machines own machine-checkable artifact correctness, the human owns intent — and allocates the gate's presentation by target: full text for behavior-shaping artifacts, the control plane, and evidence-producing artifacts; a fixed five-field intent summary with a forced plan-delta value for implementation code. Bundles the evidence-file notice hook, the deterministic detection surface for the evidence-producing category.",
      "url": "https://github.com/shimo4228/human-gate",
      "extends": "https://doi.org/10.5281/zenodo.19200726",
      "implements": "https://shimo4228.github.io/shimo4228/vocab#akc/concept/human-approval-gate",
      "groundedIn": "https://github.com/shimo4228/agent-knowledge-cycle/blob/main/docs/adr/0005-human-approval-gate.md"
    },
    {
      "@id": "https://github.com/shimo4228/repo-asset-stocktake",
      "@type": ["EcosystemRepo", "SoftwareSourceCode"],
      "name": "repo-asset-stocktake",
      "description": "AKC Maintain-phase skill (ADR-0019). Audits a project repository's non-code assets — tool configs, CI workflows, runbooks — for consumers that have vanished (Keep / Update / Retire / Merge). Tier-1 reachability is deterministic code, tier-2 value is holistic judgment — enumerate-then-decide (ADR-0008). Complements context-sync within Maintain: context-sync audits documentation role coherence, repo-asset-stocktake audits asset liveness.",
      "url": "https://github.com/shimo4228/repo-asset-stocktake",
      "extends": "https://doi.org/10.5281/zenodo.19200726",
      "implements": "https://shimo4228.github.io/shimo4228/vocab#akc-phase/maintain"
    },

